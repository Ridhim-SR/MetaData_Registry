# Copy to .env (same folder, never commit) — the backend loads it automatically.
# Real environment variables / PM2 env always win over .env values.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appdb
# Managed Postgres (Neon): use the DIRECT host (not -pooler-) when possible.
# Pooler hosts also work (prepared-statement cache is disabled automatically).
# Example: DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenMetadata server (local Docker stack)
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_API_VERSION=v1
# Bootstrap admin credentials -- change the OpenMetadata admin password on
# first login (see infrastructure/openmetadata/README.md) and put the new one
# here; `admin` is only the password a fresh OpenMetadata install boots with.
OPENMETADATA_USERNAME=admin@open-metadata.org
OPENMETADATA_PASSWORD=admin
# Long-lived bot JWT (Settings -> Bots -> ingestion-bot). Required for SDK writes.
# OPENMETADATA_JWT_TOKEN=
OPENMETADATA_TIMEOUT=30

# Social sign-in (optional - endpoints answer 501 until these are set).
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web).
# Redirect URI to allow, e.g. http://localhost:5173/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft: https://portal.azure.com -> Entra ID -> App registration.
# Redirect URI to allow, e.g. http://localhost:5173/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
