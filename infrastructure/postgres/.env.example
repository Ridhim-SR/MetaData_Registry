# Copy to `.env` in this folder (git-ignored) before the first `docker compose up`.
# The compose file refuses to start without POSTGRES_PASSWORD.

# Password for the `registry` database user. Generate one, don't invent one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Put the same value in DATABASE_URL in apps/api/.env.
POSTGRES_PASSWORD=

# Host port, bound to 127.0.0.1 only. 5432 is taken by the host Postgres on BIPP2.
POSTGRES_PORT=5434
