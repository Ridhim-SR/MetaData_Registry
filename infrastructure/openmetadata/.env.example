# Copy to `.env` in this folder (git-ignored) before the first `docker compose up`.
# Compose reads it from the compose file's own directory, so `npm run dev` and
# `docker compose -f infrastructure/openmetadata/docker-compose.yml ...` both pick it up.
#
# The compose file refuses to start without MYSQL_ROOT_PASSWORD: there is no
# default anymore (the old one was the well-known word "password", and MySQL
# used to be published on every network interface).

# Root password for the metadata MySQL. Generate one, don't invent one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_ROOT_PASSWORD=

# Self-signup stays off so only an admin can create users in the catalogue.
# (This is also the compose default now; setting it here makes it explicit.)
AUTHENTICATION_ENABLE_SELF_SIGNUP=false

# Password for the application DB user the OpenMetadata server connects as.
# Leave as-is unless you also change that user's password inside MySQL --
# the value must match, or `execute-migrate-all` and the server cannot log in.
DB_USER_PASSWORD=openmetadata_password
