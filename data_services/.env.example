# Leave WASABI_BUCKET blank to use local storage; fill it in to switch to Wasabi.
WASABI_BUCKET=
WASABI_ENDPOINT_URL=https://s3.<region>.wasabisys.com
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_REGION=

OPENMETADATA_HOST_PORT=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=

# Pipeline run defaults -- lets `python3 -m src.schema_registry.pipeline`
# run with no inline env vars at all. See README's Quickstart/Concepts.
DEPARTMENT=
DATASET=
TABLE_NAME=
SOURCE_FILE=
SOURCE_FORMAT=
CATEGORY=
API_AVAILABLE=
OWNER=
FREQUENCY=
TIMELINE=
DATASET_DESCRIPTION=
