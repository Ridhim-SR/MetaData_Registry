# ---------------------------------------------------------------------------
# Where this run reads and writes -- pick one: local | development | production
#   local        storage/ folder on this machine   + LOCAL_ OpenMetadata
#   development  Wasabi bucket, dev/ folder        + DEV_ OpenMetadata
#   production   Wasabi bucket, prod/ folder       + PROD_ OpenMetadata
# (or for one run only: ENVIRONMENT=local python3 -m src.schema_registry.pipeline)
# ---------------------------------------------------------------------------
ENVIRONMENT=local

# local: OpenMetadata on this machine (cd ../infrastructure/openmetadata && docker compose up -d)
LOCAL_OPENMETADATA_HOST_PORT=http://localhost:8585/api
LOCAL_OPENMETADATA_JWT_TOKEN=

# development: the dev server (BIPP2)
DEV_OPENMETADATA_HOST_PORT=http://10.0.96.105:8585/api
DEV_OPENMETADATA_JWT_TOKEN=

# production: not set up yet
PROD_OPENMETADATA_HOST_PORT=
PROD_OPENMETADATA_JWT_TOKEN=

# Tokens: Settings -> Bots -> ingestion-bot in that server's OpenMetadata UI.
# An admin session token expires every ~hour; get a new one with
# (swap in the server's address):
#   curl -s -X POST http://localhost:8585/api/v1/users/login \
#     -H "Content-Type: application/json" \
#     -d '{"email":"admin@open-metadata.org","password":"'$(echo -n admin | base64)'"}' \
#     | python3 -c "import json,sys; print(json.load(sys.stdin)['accessToken'])"

# ---------------------------------------------------------------------------
# Storage -- Wasabi, used by development and production (local never uses it).
# Each environment gets its own folder in the bucket: dev/ or prod/.
# ---------------------------------------------------------------------------
WASABI_BUCKET=
WASABI_ENDPOINT_URL=https://s3.<region>.wasabisys.com
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_REGION=

# ---------------------------------------------------------------------------
# What to ingest -- edit DATASET/TABLE_NAME/SOURCE_FILE/SOURCE_FORMAT per table.
# CATEGORY..DATASET_DESCRIPTION: fill in once the department confirms them;
# blank keeps whatever was set before.
# ---------------------------------------------------------------------------
DEPARTMENT=
DATASET=
TABLE_NAME=
SOURCE_FILE=
SOURCE_FORMAT=
CATEGORY=
API_AVAILABLE=
OWNER=
FREQUENCY=
TIMELINE=
DATASET_DESCRIPTION=
