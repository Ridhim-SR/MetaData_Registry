# =============================================================================
# data_services settings. Copy to .env (cp .env.example .env) and fill in.
# Never commit .env -- it holds keys and tokens.
# Anything here can be overridden for one run by putting it in front of the
# command, e.g.  ENVIRONMENT=local python3 -m src.schema_registry.sync
# =============================================================================

# -----------------------------------------------------------------------------
# 1. WHERE THIS RUN GOES -- local | development | production
#   local        storage/ folder on this machine  + LOCAL_ OpenMetadata
#   development  Wasabi bucket, dev/ folder       + DEV_ OpenMetadata (BIPP2)
#   production   Wasabi bucket, prod/ folder      + PROD_ OpenMetadata
# Branch rule: main -> development/production; other branches -> local/development.
# -----------------------------------------------------------------------------
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# 2. OPENMETADATA -- one address + token per environment; only the one for
#    ENVIRONMENT is used. Blank token = files are saved, nothing is published.
# Token: that server's UI -> Settings -> Bots -> ingestion-bot -> copy token.
# -----------------------------------------------------------------------------
# local: OpenMetadata on this machine (cd ../infrastructure/openmetadata && docker compose up -d)
LOCAL_OPENMETADATA_HOST_PORT=http://localhost:8585/api
LOCAL_OPENMETADATA_JWT_TOKEN=

# development: the dev server (BIPP2) -- needs the office network or VPN
DEV_OPENMETADATA_HOST_PORT=http://10.0.96.105:8585/api
DEV_OPENMETADATA_JWT_TOKEN=

# production: fill in when the production server is ready
PROD_OPENMETADATA_HOST_PORT=
PROD_OPENMETADATA_JWT_TOKEN=

# Local testing only: an admin login token (expires in ~1 hour) instead of the bot's:
#   curl -s -X POST http://localhost:8585/api/v1/users/login \
#     -H "Content-Type: application/json" \
#     -d '{"email":"admin@open-metadata.org","password":"'$(echo -n admin | base64)'"}' \
#     | python3 -c "import json,sys; print(json.load(sys.stdin)['accessToken'])"

# -----------------------------------------------------------------------------
# 3. WASABI STORAGE -- used by development and production (local never uses it;
#    it uses the storage/ folder). Each environment gets its own folder: dev/, prod/.
# -----------------------------------------------------------------------------
WASABI_BUCKET=
# The bucket's region, and its address: https://s3.<region>.wasabisys.com
WASABI_REGION=
WASABI_ENDPOINT_URL=https://s3.<region>.wasabisys.com
# Key the commands use. Use the pipeline user's key made by `backup setup
# --create-key` (can't permanently delete anything) -- not the account's admin/root key.
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 4. BACKUP -- a second, locked copy in another region (README -> Backups).
# Filled in: every add/sync also copies its new files there, automatically.
# Blank: no backup (each run warns). Create it once with:
#   ENVIRONMENT=development python3 -m src.storage.backup setup --pipeline-user sda-pipeline --dry-run
# -----------------------------------------------------------------------------
WASABI_BACKUP_BUCKET=
# Must differ from WASABI_REGION, so one region's outage can't take both copies.
WASABI_BACKUP_REGION=eu-central-1
# Admin key -- only for `backup setup`. Don't keep it here; put it in front of that command:
#   WASABI_ADMIN_ACCESS_KEY_ID=... WASABI_ADMIN_SECRET_ACCESS_KEY=... python3 -m src.storage.backup setup ...

# -----------------------------------------------------------------------------
# 5. ONE-TABLE TEST RUN (optional) -- only for `python3 -m src.schema_registry.pipeline`.
#    add and sync don't read these: they use catalog.yaml.
# SOURCE_FILE: a path on this machine, or storage:<key> for a file in storage.
# SOURCE_FORMAT: postgres_ddl | csv.  CATEGORY: CAT-1..CAT-4.
# Blank CATEGORY..DATASET_DESCRIPTION keeps what was set before.
# -----------------------------------------------------------------------------
DEPARTMENT=
DATASET=
TABLE_NAME=
SOURCE_FILE=
SOURCE_FORMAT=
CATEGORY=
API_AVAILABLE=
OWNER=
FREQUENCY=
TIMELINE=
DATASET_DESCRIPTION=
