# data_services environment configuration
# Copy this file to .env and fill in the values.
# Never commit .env; it contains credentials and tokens.

# -----------------------------------------------------------------------------
# 1. Runtime environment
# -----------------------------------------------------------------------------
# Blank follows the checked-out branch:
#   feature branch -> local
#   main           -> development
#   production     -> production
ENVIRONMENT=
LOCAL_ONLY=1

# -----------------------------------------------------------------------------
# 2. OpenMetadata endpoints and credentials
# -----------------------------------------------------------------------------
# Normal ingestion/publishing token.
LOCAL_OPENMETADATA_HOST_PORT=http://localhost:8585/api
LOCAL_OPENMETADATA_JWT_TOKEN=

DEV_OPENMETADATA_HOST_PORT=http://10.0.96.105:8585/api
DEV_OPENMETADATA_JWT_TOKEN=

PROD_OPENMETADATA_HOST_PORT=
PROD_OPENMETADATA_JWT_TOKEN=

# Dedicated administrator token for permanent deletion only.
# Do not reuse the normal ingestion token.
LOCAL_OPENMETADATA_ADMIN_JWT_TOKEN=
DEV_OPENMETADATA_ADMIN_JWT_TOKEN=
PROD_OPENMETADATA_ADMIN_JWT_TOKEN=

# To obtain a temporary local admin token after OpenMetadata starts:
#   curl -s -X POST http://localhost:8585/api/v1/users/login `
#     -H "Content-Type: application/json" `
#     -d '{"email":"admin@open-metadata.org","password":"<base64-password>"}'

# -----------------------------------------------------------------------------
# 3. Shared Wasabi storage: development and production only
# -----------------------------------------------------------------------------
WASABI_BUCKET=
WASABI_REGION=
WASABI_ENDPOINT_URL=https://s3.<region>.wasabisys.com
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# Dedicated deletion credentials; never use the pipeline credentials above.
WASABI_DELETE_ACCESS_KEY_ID=
WASABI_DELETE_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 4. Local S3-compatible storage: MinIO for feature branches
# -----------------------------------------------------------------------------
# Start infrastructure/minio before using these settings.
LOCAL_WASABI_BUCKET=sda-local
LOCAL_WASABI_REGION=us-east-1
LOCAL_WASABI_ENDPOINT_URL=http://localhost:9000
LOCAL_WASABI_ACCESS_KEY_ID=minioadmin
LOCAL_WASABI_SECRET_ACCESS_KEY=minioadmin

# Local deletion credentials. Keep separate from production credentials.
LOCAL_WASABI_DELETE_ACCESS_KEY_ID=minioadmin
LOCAL_WASABI_DELETE_SECRET_ACCESS_KEY=minioadmin

# Local backup bucket.
LOCAL_WASABI_BACKUP_BUCKET=sda-local-backup
LOCAL_WASABI_BACKUP_REGION=us-east-1
LOCAL_WASABI_BACKUP_ENDPOINT_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# 5. Backup storage
# -----------------------------------------------------------------------------
WASABI_BACKUP_BUCKET=
WASABI_BACKUP_REGION=eu-central-1
WASABI_BACKUP_ENDPOINT_URL=

# Admin credentials are supplied only for backup setup, not stored here:
#   WASABI_ADMIN_ACCESS_KEY_ID=... `
#   WASABI_ADMIN_SECRET_ACCESS_KEY=... `
#   python3 -m src.storage.backup setup --pipeline-user sda-pipeline --dry-run

# -----------------------------------------------------------------------------
# 6. Optional one-table pipeline run
# -----------------------------------------------------------------------------
DEPARTMENT=
DATASET=
TABLE_NAME=
SOURCE_FILE=
SOURCE_FORMAT=
CATEGORY=
API_AVAILABLE=
OWNER=
FREQUENCY=
TIMELINE=
DATASET_DESCRIPTION=

# -----------------------------------------------------------------------------
# 7. Optional AI metadata drafting
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
