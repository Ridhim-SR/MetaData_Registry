{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
   "scripts": {
    "dev": "npm run dev:openmetadata && npm run dev:apps",
    "dev:openmetadata": "docker compose -f infrastructure/openmetadata/docker-compose.yml up -d --wait",
    "dev:apps": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "turbo": "^2.10.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
