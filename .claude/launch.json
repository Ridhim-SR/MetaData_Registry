{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=api"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=web"],
      "port": 5173
    },
    {
      "name": "api-verify",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd apps\\api && set CORS_ALLOW_ORIGINS=http://localhost:5174&& .venv\\Scripts\\python.exe -m uvicorn src.main:app --port 8001"],
      "port": 8001
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_BASE_URL=http://localhost:8001&& npm run dev --workspace=web -- --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
